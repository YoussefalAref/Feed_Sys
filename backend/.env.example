DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/biteapple
BITEAPPLE_CORE_PATH=../build/phase6/Debug
## Paymob (Phase 4.5) configuration
# Use mock mode for local development/testing. Set to `false` for real sandbox testing.
PAYMOB_MOCK_MODE=true

# Required for sandbox/live testing WHEN `PAYMOB_MOCK_MODE=false`.
# Please copy these into `backend/.env` and fill with values from your
# Paymob sandbox dashboard. These are REQUIRED for end-to-end webhook
# verification and live checkout flows.
PAYMOB_API_KEY=YOUR_PAYMOB_API_KEY_HERE
PAYMOB_INTEGRATION_ID=YOUR_PAYMOB_INTEGRATION_ID_HERE
PAYMOB_PUBLIC_KEY=YOUR_PAYMOB_PUBLIC_KEY_HERE
PAYMOB_HMAC_SECRET=YOUR_PAYMOB_HMAC_SECRET_HERE

PAYMOB_CHECKOUT_URL=https://accept.paymob.com/standalone
PAYMOB_CURRENCY=EGP

# Webhook/callback URL Paymob will call for payment updates. Update this to
# your current ngrok/public URL when testing locally (required for sandbox).
PAYMOB_WEBHOOK_URL=YOUR_PUBLIC_PAYMOB_WEBHOOK_URL_HERE
